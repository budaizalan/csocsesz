<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nav="clr-namespace:Csocsesz.ContentViews"
             x:Class="Csocsesz.ContentPages.SettingsPage"
             BackgroundColor="Black">
    <Grid RowDefinitions="120, *, 120" ColumnDefinitions="*" Margin="10">
        <Label
            Text="SETTINGS"
            Style="{StaticResource Title}"
            VerticalOptions="Center"
            HorizontalTextAlignment="Center"
            Grid.Row="0"
            />
        <Grid RowDefinitions="6*,1*,10*,1*" 
              Grid.Row="1">
            <Grid RowDefinitions="5*,*,5*" ColumnDefinitions="3*,2*"
                  Grid.Row="0">
                <Border
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource DarkGray}"
                    Padding="15"
                    Grid.Row="0"
                    Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid ColumnDefinitions="3*,2*">
                        <Label 
                            Text="Player Red"
                            Style="{StaticResource BiggerNormal}"
                            VerticalOptions="Center" HorizontalOptions="Start"
                            Grid.Row="1" Grid.Column="0"/>
                        <Picker 
                            x:Name="PlayerRedPicker"
                            Title="Select Player"
                            ItemDisplayBinding="{Binding name}"
                            TextColor="White"
                            TitleColor="Gray"
                            SelectedIndexChanged="OnPlayerRedChanged"
                            VerticalOptions="Center" HorizontalOptions="End"
                            Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                </Border>
                <Border
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource DarkGray}"
                    Padding="15"
                    Grid.Row="2"
                    Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid ColumnDefinitions="3*,2*">
                        <Label 
                            Text="Player Blue"
                            Style="{StaticResource BiggerNormal}"
                            VerticalOptions="Center" HorizontalOptions="Start"
                            Grid.Row="0" Grid.Column="0"/>
                        <Picker 
                            x:Name="PlayerBluePicker"
                            Title="Select Player"
                            ItemDisplayBinding="{Binding name}"
                            TextColor="White"
                            TitleColor="Gray"
                            SelectedIndexChanged="OnPlayerBlueChanged"
                            VerticalOptions="Center" HorizontalOptions="End"
                            Grid.Row="0" Grid.Column="1"/>
                    </Grid>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                </Border>
            </Grid>
            <Grid RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="3*, 2*"
                  Padding="10"
                  Grid.Row="2">
                <Label 
                    Text="Auto Side Switch"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="0" Grid.Column="0"/>
                <Switch
                    x:Name="AutoSideSwitch"
                    Toggled="OnAutoSideSwitchChanged"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="0" Grid.Column="1"/>
                <Label 
                    x:Name="PushUpsMultiplierEntry"
                    Text="Punishment Multiplier"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="1" Grid.Column="0"/>
                <Entry
                    Text="3"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Normal}"
                    Completed="OnPushUpsMultiplierChanged"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="1" Grid.Column="1"/>
                <Label 
                    Text="Save Test Matches (&lt;30s)"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="2" Grid.Column="0"/>
                <Switch
                    x:Name="SaveTestMatchesSwitch"
                    Toggled="OnSaveTestMatchesChanged"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="2" Grid.Column="1"/>
                <Label
                    x:Name="DataBaseStatsLabel"
                    Text="No Data"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
                <Button
                    x:Name="RefreshDataBaseButton"
                    Text="REFRESH DATABASE"
                    Style="{StaticResource BigNormal}"
                    BackgroundColor="Gray"
                    Clicked="RefreshDataBaseButtonClicked"
                    VerticalOptions="Fill" HorizontalOptions="Fill"
                    Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"/>
            </Grid>
        </Grid>
        <nav:NavBar x:Name="Navbar" Grid.Row="2"/>
    </Grid>
</ContentPage>