<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nav="clr-namespace:Csocsesz.ContentViews"
             x:Class="Csocsesz.ContentPages.StatsPage"
             BackgroundColor="Black">
    <Grid RowDefinitions="100, *, 120" Margin="10">
        <Label
            Text="STATS"
            Style="{StaticResource Title}"
            VerticalOptions="Center"
            HorizontalTextAlignment="Center"
            Grid.Row="0"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="10,0">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="Mode1v1Button" Text="1 v 1" Style="{StaticResource RegularButtonStyle}"
                            Clicked="ModeButtonClicked" Grid.Column="0"/>
                    <Button x:Name="Mode2v2Button" Text="2 v 2" Style="{StaticResource RegularButtonStyle}"
                            Clicked="ModeButtonClicked" Grid.Column="1"/>
                </Grid>

                <Border StrokeThickness="0" BackgroundColor="{StaticResource DarkGray}" Padding="15,5">
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="8">
                        <Label x:Name="PlayerHeaderLabel" Text="Player" Style="{StaticResource BiggerNormal}"
                               VerticalOptions="Center" Grid.Column="0"/>
                        <Picker x:Name="PlayerPicker" Title="Player" ItemDisplayBinding="{Binding name}"
                                TextColor="White" TitleColor="White" HorizontalTextAlignment="End"
                                SelectedIndexChanged="OnPlayerChanged"
                                VerticalOptions="Center" Grid.Column="1"/>
                        <Picker x:Name="Player2Picker" Title="Player 2" ItemDisplayBinding="{Binding name}"
                                TextColor="White" TitleColor="White" HorizontalTextAlignment="End"
                                SelectedIndexChanged="OnPlayerChanged"
                                VerticalOptions="Center" Grid.Column="2"/>
                    </Grid>
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                </Border>

                <Border StrokeThickness="0" BackgroundColor="{StaticResource DarkGray}" Padding="15">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="16" ColumnSpacing="10">
                        <Label Text="Win Streak" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="0"/>
                        <Label x:Name="WinStreakLabel" Text="No Data" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="1"/>

                        <Label Text="Winrate" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="0"/>
                        <Label x:Name="WinRateLabel" Text="No Data" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="1"/>

                        <Label Text="Goal Ratio&#10;(Scored/Conceded)" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="0"/>
                        <Label x:Name="GoalScoredConcededRatioLabel" Text="No Data" Style="{StaticResource Normal}"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                </Border>

                <Border x:Name="PunishmentSection" StrokeThickness="0" BackgroundColor="{StaticResource DarkGray}" Padding="15">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Punishment(s)" Style="{StaticResource BiggerNormal}" HorizontalOptions="Center"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="To Do&#10;(Assigned - Completed)" Style="{StaticResource Normal}"
                                   VerticalOptions="Center" Grid.Column="0"/>
                            <Label x:Name="PunishmentToDoLabel" Text="No Data" Style="{StaticResource BiggerNormal}"
                                   VerticalOptions="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,60,Auto" ColumnSpacing="10">
                            <Button x:Name="PunishmentCompleteButton" Text="COMPLETE"
                                    Style="{StaticResource RegularButtonStyle}"
                                    Clicked="PunishmentCompleteButtonClicked" Grid.Column="0"/>
                            <Button x:Name="PunishmentMinusButton" Text="-" Style="{StaticResource RegularButtonStyle}"
                                    WidthRequest="60" Clicked="PunishmentMinusButtonClicked" Grid.Column="1"/>
                            <Label x:Name="PunishmentCounter" Text="0" Style="{StaticResource BigNormal}"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="2"/>
                            <Button x:Name="PunishmentPlusButton" Text="+" Style="{StaticResource RegularButtonStyle}"
                                    WidthRequest="60" Clicked="PunishmentPlusButtonClicked" Grid.Column="3"/>
                        </Grid>
                    </VerticalStackLayout>
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <nav:NavBar x:Name="Navbar" Grid.Row="2"/>
    </Grid>
</ContentPage>
