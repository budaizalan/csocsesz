<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nav="clr-namespace:Csocsesz.ContentViews"
             x:Class="Csocsesz.ContentPages.StatsPage"
             BackgroundColor="Black">
    <Grid RowDefinitions="120, *, 120" ColumnDefinitions="*" Margin="10">
        <Label
        Text="STATS"
        Style="{StaticResource Title}"
        VerticalOptions="Center"
        HorizontalTextAlignment="Center"
        Grid.Row="0"/>
        <Grid RowDefinitions="1*,6*" Grid.Row="1" Padding="5, 0">
            <Border
                StrokeThickness="0"
                Grid.Row="0"
                BackgroundColor="{StaticResource DarkGray}"
                Padding="10">
                <Grid ColumnDefinitions="3*,2*" Padding="5">
                    <Label 
                        Text="Player"
                        Style="{StaticResource BiggerNormal}"
                        FontFamily="CenturyGothicBold"
                        VerticalOptions="Center" HorizontalOptions="Start"
                        Grid.Column="0"/>
                    <Picker 
                        x:Name="PlayerPicker"
                        Title="Select Player"
                        ItemDisplayBinding="{Binding name}"
                        TextColor="White"
                        TitleColor="White"
                        SelectedIndexChanged="OnPlayerChanged"
                        VerticalOptions="Center" HorizontalOptions="End"
                        Grid.Column="1"/>
                </Grid>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            </Border>
            
            <Grid RowDefinitions="0.5*,*,*,*,*,2.5*" ColumnDefinitions="2*,2*" 
                  Padding="15,0"
                  Grid.Row="1" >

                <Label 
                    Text="Win Streak"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="1" Grid.Column="0"/>
                <Label
                    x:Name="WinStreakLabel"
                    Text="No Data"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="1" Grid.Column="1"/>

                <Label 
                    Text="Winrate"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="2" Grid.Column="0"/>
                <Label
                    x:Name="WinRateLabel"
                    Text="No Data"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="2" Grid.Column="1"/>

                <Label 
                    Text="Goal Ratio&#10;(Scored/Conceded)"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="3" Grid.Column="0"/>
                <Label
                    x:Name="GoalScoredConcededRatioLabel"
                    Text="No Data"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="3" Grid.Column="1"/>

                <Label 
                    Text="Punishment to Do&#10;(Assigned - Completed)"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="Start"
                    Grid.Row="4" Grid.Column="0"/>
                <Label
                    x:Name="PunishmentToDoLabel"
                    Text="No Data"
                    Style="{StaticResource Normal}"
                    VerticalOptions="Center" HorizontalOptions="End"
                    Grid.Row="4" Grid.Column="1"/>
            </Grid>
        </Grid>
        <nav:NavBar x:Name="Navbar" Grid.Row="2"/>
    </Grid>
</ContentPage>